NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# FIFA Mentoring (admin-only area). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# Supabase -> Project Settings -> API -> service_role key. Set it in Vercel too.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional. Signs FIFA Mentoring session cookies. Falls back to the service role key.
# FIFA_SESSION_SECRET=any-long-random-string

# Admin sign-in is checked on the server using the service role key above.
# Optional recovery PIN that signs in as FA Admin (server-only).
# SUPPORT_ACCESS_KEY=a-long-recovery-pin
# Optional: only used if no admin settings were ever saved.
# CODA_BOOTSTRAP_ADMIN_NAME=Your Name
# CODA_BOOTSTRAP_ADMIN_PIN=0000
